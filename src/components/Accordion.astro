---
interface Props {
  title: string;
  /** Short tag rendered as a chip — e.g. the LOB shorthand ("Motor", "Cyber"). */
  tag?: string;
}
const { title, tag } = Astro.props;
---

{/* Built on <details> so it works without JavaScript, is keyboard-accessible
    and searchable by the browser's find-in-page. */}
<details class="acc">
  <summary>
    {tag && <span class="lobtag">{tag}</span>}
    <span class="title">{title}</span>
    <span class="chev" aria-hidden="true">▶</span>
  </summary>
  <div class="inner"><slot /></div>
</details>

<style>
  .acc {
    border: 1px solid var(--ledger-border);
    border-radius: 10px;
    background: var(--ledger-surface);
    margin: 0.5rem 0;
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--ledger-heading);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--ledger-surface-alt);
  }
  summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .lobtag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--ledger-surface-alt);
    border: 1px solid var(--ledger-border);
    color: var(--ledger-quiet);
  }
  .title {
    flex: 1;
    min-width: 0;
  }
  .chev {
    flex-shrink: 0;
    font-size: 0.7rem;
    color: var(--ledger-quiet);
    transition: transform 0.15s ease;
  }
  .acc[open] .chev {
    transform: rotate(90deg);
  }
  .inner {
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--ledger-border);
    font-size: 0.925rem;
    color: var(--ledger-body);
  }
  .inner :global(> :first-child) {
    margin-top: 0.75rem;
  }
  .inner :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
