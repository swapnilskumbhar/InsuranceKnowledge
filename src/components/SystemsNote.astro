---
/**
 * SystemsNote — "What this means for your system".
 *
 * The handbook's editorial contract says every page must answer this. Giving it
 * a dedicated component makes a missing answer visible at a glance during review,
 * rather than something you have to read the whole page to notice.
 */
---

<aside class="sysnote">
  <span class="kicker">What this means for your system</span>
  <div class="body"><slot /></div>
</aside>

<style>
  .sysnote {
    border: 1.5px solid var(--ledger-heading);
    border-radius: 10px;
    background: var(--ledger-surface);
    padding: 1rem 1.15rem;
    margin: 1.75rem 0;
    position: relative;
  }
  .kicker {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ledger-heading);
  }
  .body {
    color: var(--ledger-body);
    font-size: 0.925rem;
  }
  .body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
